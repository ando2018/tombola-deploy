PORT=3002
MONGO_URI=mongodb://127.0.0.1:27017/tombola
# Secret de signature des JWT : à changer impérativement en production
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
# Clé de chiffrement des jetons d'abonnement (facultatif : dérivée de JWT_SECRET sinon).
# Si elle change, les jetons existants ne peuvent plus être recopiés (il faut les régénérer).
# TOKEN_SECRET=
# Compte super admin (gestion des organisations et abonnements)
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=change-moi
CORS_ORIGIN=http://localhost:4200

# --- E-mails (facultatif) ---
# Sans SMTP_HOST, les messages de contact sont seulement enregistrés (onglet Messages du super admin).
# SUPERADMIN_EMAIL=vous@exemple.fr
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Tombola <tombola@exemple.fr>"
